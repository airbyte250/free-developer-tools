generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String   @id @default(uuid())
  hostname           String   @unique
  status             String   @default("active") // active, paused, pending_review
  categoryId         String   @map("category_id")
  adClientId         String?  @map("ad_client_id") // ca-pub-XXXXXXXXXXXXXXXX (optional)
  bannerSlotId       String?  @map("banner_slot_id")
  interstitialSlotId String?  @map("interstitial_slot_id")
  anchorSlotId       String?  @map("anchor_slot_id")
  analyticsId        String?  @map("analytics_id") // G-XXXXXX
  headerScript       String?  @map("header_script") // Custom header code (verification tags, meta, scripts)
  customBannerCode   String?  @map("custom_banner_code") // Custom banner ad HTML (above quiz)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category   Category     @relation(fields: [categoryId], references: [id])
  adsTxt     AdsTxt[]
  goSettings GoSettings[]
  goImages   GoImage[]

  @@map("tenants")
}

model Category {
  id              String   @id @default(uuid())
  slug            String   @unique
  metaTitle       String   @map("meta_title")
  metaDescription String   @map("meta_description")
  quizData        Json     @map("quiz_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("categories")
}

model AdsTxt {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  line     String // e.g., "google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0"

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ads_txt")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  status    String   @default("pending") // pending, active, rejected
  role      String   @default("user") // user, admin
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model GoSettings {
  id       String  @id @default("default")
  key      String
  value    String  @db.Text
  tenantId String? @map("tenant_id")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId])
  @@map("go_settings")
}

model GoImage {
  id        String   @id @default(uuid())
  tileId    String   @unique @map("tile_id")
  link      String   @default("/go")
  cols      Int      @default(10)
  rows      Int      @default(10)
  count     Int      @default(100)
  width     Int      @default(1920)
  height    Int      @default(1080)
  manifest  Json     @default("[]")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("go_images")
}
