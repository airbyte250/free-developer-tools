# ─── YouTube Video Uploader – Environment Configuration ───
# Copy this file to `.env` and fill in the values.

# Path to the folder containing your video files (.mp4, .mkv)
VIDEO_DIR=./videos_to_upload

# Path to the CSV metadata file (see sample_metadata/videos.csv)
METADATA_FILE=./sample_metadata/videos.csv

# OAuth 2.0 client secrets downloaded from Google Cloud Console
CLIENT_SECRETS_FILE=./client_secrets.json

# Cached OAuth token (auto-created after first login)
TOKEN_FILE=./token.json

# Log file path
LOG_FILE=./uploader.log

# Upload chunk size in bytes (default: 256 KB = 262144)
UPLOAD_CHUNK_SIZE=262144

# Anti-spam delay range in seconds between consecutive uploads
MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=600
