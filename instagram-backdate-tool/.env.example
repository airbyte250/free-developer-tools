# Meta app credentials — from https://developers.facebook.com/apps
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_API_VERSION=v23.0

# Public URL of this app. Must match the OAuth redirect URI registered in the
# Meta app (Facebook Login > Settings > Valid OAuth Redirect URIs):
#   <BASE_URL>/auth/callback
BASE_URL=http://localhost:8000

# Random string used to sign the session cookie.
SECRET_KEY=replace-with-a-long-random-string

# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/backdate
DATABASE_URL=sqlite:///./backdate.db

# Reject scheduling posts further than this many days in the future.
MAX_FUTURE_DAYS=30
